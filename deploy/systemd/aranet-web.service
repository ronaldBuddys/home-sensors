[Unit]
Description=Aranet Monitor web (FastAPI API + Dash dashboard)
Documentation=file://@REPO@/docs/DEPLOYMENT.md
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/aranet serve
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
