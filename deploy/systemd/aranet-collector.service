[Unit]
Description=Aranet BLE collector (passive scan -> database)
Documentation=file://@REPO@/docs/DEPLOYMENT.md
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/aranet collect
Restart=always
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
