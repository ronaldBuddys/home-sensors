# Copy to .env and adjust. Never commit .env.

# Database: SQLite file (the default when nothing below is set) ...
# ARANET_DB_URL=sqlite:///data/aranet.sqlite
# ... or Postgres. Either a full URL:
# ARANET_DB_URL=postgresql+psycopg://aranet:CHANGE_ME@db-host:5432/aranet
# ... or the parts (used only when ARANET_DB_URL is unset):
# POSTGRES_HOST=db-host
# POSTGRES_PORT=5432
# POSTGRES_DB=aranet
# POSTGRES_USER=aranet
# POSTGRES_PASSWORD=CHANGE_ME
# TLS to a LAN/remote server (needs ssl=on on the server; see docs/DEPLOYMENT.md §5).
# Unset = libpq 'prefer': encrypted only if the server offers it, server never verified.
# verify-full = always encrypted + the server certificate must match POSTGRES_HOST.
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=data/tls/ca.crt   # CA that signed the server cert (scripts/make-cert.sh)

# Optional separate login for the web app (dashboard), ideally a read-only role:
#   CREATE ROLE dashboard_ro LOGIN PASSWORD '...';   -- once, as a DB admin
#   uv run aranet grant-read dashboard_ro            -- once, as the app role (owns the tables)
# ARANET_WEB_DB_USER=dashboard_ro
# ARANET_WEB_DB_PASSWORD=CHANGE_ME

# Recommended: comma-separated allow-list of sensor BLE addresses. Without it any (possibly
# spoofed) Aranet advert is accepted and only previously known devices are auto-backfilled.
# ARANET_DEVICES=AA:BB:CC:DD:EE:FF

# Collector
ARANET_BACKFILL_ON_START=1      # download on-device history on start-up if there is a gap
ARANET_GAP_BACKFILL_MIN_S=150   # gaps longer than this (and >= 1.5x interval) trigger a GATT backfill
ARANET_WATCHDOG_S=180           # restart the BLE scanner after this long without adverts
ARANET_BLE_TIMEOUT_S=30         # per GATT operation
ARANET_WAIT_CLOCK_SYNC_S=300    # Pi/no RTC: wait up to this long for NTP sync before recording (0 = off)

# Web (FastAPI + Dash)
ARANET_WEB_HOST=127.0.0.1       # use 0.0.0.0 to expose on your LAN
ARANET_WEB_PORT=8050
ARANET_REFRESH_S=30
ARANET_CO2_WARN=1000
ARANET_CO2_ALERT=1400
# ARANET_TZ=Europe/London       # display timezone (default: system local time)
# HTTP Basic auth for the whole web app (required if ARANET_WEB_HOST is not loopback).
# Use a long random password, e.g. `openssl rand -base64 24`. 5 wrong tries => 10 min lockout.
# ARANET_WEB_USER=aranet
# ARANET_WEB_PASSWORD=CHANGE_ME
# HTTPS for the web app, so the password isn't sent in clear text on the LAN
# (e.g. ./scripts/make-cert.sh web <LAN IP> <hostname>; install data/tls/ca.crt on your devices)
# ARANET_WEB_TLS_CERT=data/tls/web.crt
# ARANET_WEB_TLS_KEY=data/tls/web.key

# Optional Postgres schema for all tables (must exist and be owned/writable by the DB user), e.g.
#   CREATE SCHEMA aranet AUTHORIZATION <db user>;   -- run once as a DB admin
# ARANET_DB_SCHEMA=aranet

# Serve Swagger UI at /api/docs (loads JS from a CDN; off by default)
# ARANET_API_DOCS=1
